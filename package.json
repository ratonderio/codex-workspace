{
  "name": "games-workspace",
  "private": true,
  "scripts": {
    "setup": "npm --prefix projects/type-hero ci",
    "test": "npm --prefix projects/type-hero test",
    "validate-content": "npm --prefix projects/type-hero run validate-content",
    "build": "npm --prefix projects/type-hero run build",
    "check": "npm run validate-content && npm test",
    "precommit": "npm run check",
    "prepare": "git config core.hooksPath .githooks"
  }
}
